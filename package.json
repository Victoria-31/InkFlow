{
  "name": "inkflow",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "migrate": "pnpm --filter @inkflow/server prisma:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "studio": "pnpm --filter @inkflow/server prisma:studio"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
