// InkFlow — Prisma schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ARTIST
  CLIENT
}

enum ProjectStatus {
  REQUEST
  FRAMING
  QUOTE_SENT
  QUOTE_ACCEPTED
  AWAITING_DEPOSIT
  CREATION
  SESSION_DONE
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum AppointmentStatus {
  PROPOSED
  CONFIRMED
  DONE
  RESCHEDULED
  CANCELLED
}

enum SketchStatus {
  DRAFT
  REVISION
  CURRENT
  VALIDATED
}

enum ReferenceSource {
  CLIENT
  ARTIST
}

// Half-days: weekday + AM (morning) / PM (afternoon)
enum Availability {
  MON_AM
  MON_PM
  TUE_AM
  TUE_PM
  WED_AM
  WED_PM
  THU_AM
  THU_PM
  FRI_AM
  FRI_PM
  SAT_AM
  SAT_PM
  SUN_AM
  SUN_PM
}

// ---------- Models ----------

model Account {
  id        Int      @id @default(autoincrement())
  lastName  String   @map("last_name") @db.VarChar(100)
  firstName String   @map("first_name") @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  artist          Artist?
  projects        Project[]        // projects ordered as a client
  requestComments RequestComment[]
  sketchComments  SketchComment[]

  @@map("account")
}

model Artist {
  id                   Int     @id @default(autoincrement())
  username             String  @unique @db.VarChar(100) // public link slug: inkflow.fr/<username>
  defaultSketchSharing Boolean @default(true) @map("default_sketch_sharing")
  aftercareAdvice      String? @map("aftercare_advice") @db.Text
  prepAdvice           String? @map("prep_advice") @db.Text
  bio                  String? @db.Text
  city                 String? @db.VarChar(100)
  address              String? @db.VarChar(255) // default session location (private studio)
  portrait             String? @db.VarChar(255) // file path in object storage
  workingSlots         Availability[] @default([]) @map("working_slots") // half-days the artist works

  accountId Int     @unique @map("account_id")
  account   Account @relation(fields: [accountId], references: [id])

  studioId Int?    @map("studio_id")
  studio   Studio? @relation(fields: [studioId], references: [id])

  projects Project[]
  tags     ArtistTag[]

  @@map("artist")
}

model Studio {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(150)
  address String? @db.VarChar(255)

  artists Artist[]

  @@map("studio")
}

model Project {
  id                Int           @id @default(autoincrement())
  status            ProjectStatus @default(REQUEST)
  bodyArea          String        @map("body_area") @db.VarChar(100)
  size              String        @db.VarChar(50)
  clientBudgetMin   Decimal?      @map("client_budget_min") @db.Decimal(8, 2)
  clientBudgetMax   Decimal?      @map("client_budget_max") @db.Decimal(8, 2)
  clientNote        String        @map("client_note") @db.VarChar(2000)
  clientAvailability     Availability[] @default([]) @map("client_availability")
  clientFlexibleSchedule Boolean        @default(false) @map("client_flexible_schedule")
  internalNote      String?       @map("internal_note") @db.Text
  sketchSharing     Boolean?      @map("sketch_sharing")
  depositReceivedAt DateTime?     @map("deposit_received_at")
  createdAt         DateTime      @default(now()) @map("created_at")

  // Prospect contact details, entered with the request before the client account exists
  prospectFirstName String @map("prospect_first_name") @db.VarChar(100)
  prospectLastName  String @map("prospect_last_name") @db.VarChar(100)
  prospectEmail     String @map("prospect_email") @db.VarChar(255)

  // Client invitation link: only a hash of the token is stored; cleared once the account is activated
  inviteTokenHash String?   @unique @map("invite_token_hash") @db.VarChar(255)
  inviteExpiresAt DateTime? @map("invite_expires_at")

  artistId Int    @map("artist_id")
  artist   Artist @relation(fields: [artistId], references: [id])

  clientId Int?     @map("client_id")
  client   Account? @relation(fields: [clientId], references: [id])

  quotes          Quote[]
  appointments    Appointment[]
  sketches        Sketch[]
  references      Reference[]
  requestComments RequestComment[]
  tags            ProjectTag[]

  @@map("project")
}

model Quote {
  id            Int         @id @default(autoincrement())
  totalAmount   Decimal     @map("total_amount") @db.Decimal(8, 2)
  depositAmount Decimal?    @map("deposit_amount") @db.Decimal(8, 2)
  description   String?     @db.Text
  status        QuoteStatus @default(DRAFT)
  justification String?     @db.Text
  validUntil    DateTime    @map("valid_until") @db.Date // prefilled by the API to issue date + 7 days, editable by the artist
  respondedAt   DateTime?   @map("responded_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  @@map("quote")
}

model Appointment {
  id              Int               @id @default(autoincrement())
  date            DateTime
  durationMinutes Int               @map("duration_minutes") // duration announced in the quote = length of the booked slot
  location        String?           @db.VarChar(255)
  status          AppointmentStatus @default(PROPOSED)

  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  @@map("appointment")
}

model Sketch {
  id           Int          @id @default(autoincrement())
  version      Int
  status       SketchStatus @default(DRAFT)
  originalFile String       @map("original_file") @db.VarChar(255)
  preview      String?      @db.VarChar(255)
  validatedAt  DateTime?    @map("validated_at")

  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  comments SketchComment[]

  @@unique([projectId, version])
  @@map("sketch")
}

model Reference {
  id     Int             @id @default(autoincrement())
  file   String          @db.VarChar(255)
  source ReferenceSource

  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  @@map("reference")
}

model RequestComment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  authorId Int     @map("account_id")
  author   Account @relation(fields: [authorId], references: [id])

  @@map("request_comment")
}

model SketchComment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  sketchId Int    @map("sketch_id")
  sketch   Sketch @relation(fields: [sketchId], references: [id])

  authorId Int     @map("account_id")
  author   Account @relation(fields: [authorId], references: [id])

  @@map("sketch_comment")
}

// Tags: shared vocabulary of tattoo styles (replaces the former Project.style field)
model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(50)

  projects ProjectTag[]
  artists  ArtistTag[]

  @@map("tag")
}

model ProjectTag {
  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tagId Int @map("tag_id")
  tag   Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@map("project_tag")
}

// Styles the artist practices (same vocabulary as projects)
model ArtistTag {
  artistId Int    @map("artist_id")
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  tagId Int @map("tag_id")
  tag   Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([artistId, tagId])
  @@map("artist_tag")
}
