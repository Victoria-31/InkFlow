// InkFlow — Prisma schema
// Cible : PostgreSQL. À placer dans server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ARTIST
  CLIENT
}

enum ProjectStatus {
  REQUEST
  FRAMING
  QUOTE_SENT
  QUOTE_ACCEPTED
  AWAITING_DEPOSIT
  CREATION
  SESSION_DONE
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum AppointmentStatus {
  PROPOSED
  CONFIRMED
  DONE
  RESCHEDULED
  CANCELLED
}

enum SketchStatus {
  DRAFT
  REVISION
  CURRENT
  VALIDATED
}

enum ReferenceSource {
  CLIENT
  ARTIST
}

// ---------- Models ----------

model Account {
  id        Int      @id @default(autoincrement())
  lastName  String   @map("last_name") @db.VarChar(100)
  firstName String   @map("first_name") @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  artist          Artist?
  projects        Project[]        // projets commandés en tant que client
  requestComments RequestComment[]
  sketchComments  SketchComment[]

  @@map("account")
}

model Artist {
  id                   Int     @id @default(autoincrement())
  username             String  @db.VarChar(100)
  defaultSketchSharing Boolean @default(true) @map("default_sketch_sharing")
  aftercareAdvice      String? @map("aftercare_advice") @db.Text
  prepAdvice           String? @map("prep_advice") @db.Text

  accountId Int     @unique @map("account_id")
  account   Account @relation(fields: [accountId], references: [id])

  studioId Int?    @map("studio_id")
  studio   Studio? @relation(fields: [studioId], references: [id])

  projects Project[]

  @@map("artist")
}

model Studio {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(150)
  address String? @db.VarChar(255)

  artists Artist[]

  @@map("studio")
}

model Project {
  id                Int           @id @default(autoincrement())
  status            ProjectStatus
  bodyArea          String        @map("body_area") @db.VarChar(100)
  size              String?       @db.VarChar(50)
  clientBudgetMin   Decimal?      @map("client_budget_min") @db.Decimal(8, 2)
  clientBudgetMax   Decimal?      @map("client_budget_max") @db.Decimal(8, 2)
  clientNote        String        @map("client_note") @db.Text
  internalNote      String?       @map("internal_note") @db.Text
  sketchSharing     Boolean?      @map("sketch_sharing")
  depositReceivedAt DateTime?     @map("deposit_received_at")
  createdAt         DateTime      @default(now()) @map("created_at")

  // Coordonnées du prospect (saisies à la demande, avant création du compte)
  prospectFirstName String @map("prospect_first_name") @db.VarChar(100)
  prospectLastName  String @map("prospect_last_name") @db.VarChar(100)
  prospectEmail     String @map("prospect_email") @db.VarChar(255)

  artistId Int    @map("artist_id")
  artist   Artist @relation(fields: [artistId], references: [id])

  clientId Int?     @map("client_id")
  client   Account? @relation(fields: [clientId], references: [id])

  quotes          Quote[]
  appointments    Appointment[]
  sketches        Sketch[]
  references      Reference[]
  requestComments RequestComment[]
  tags            ProjectTag[]

  @@map("project")
}

model Quote {
  id            Int         @id @default(autoincrement())
  totalAmount   Decimal     @map("total_amount") @db.Decimal(8, 2)
  depositAmount Decimal?    @map("deposit_amount") @db.Decimal(8, 2)
  description   String?     @db.Text
  status        QuoteStatus
  justification String?     @db.Text
  validUntil    DateTime    @map("valid_until") @db.Date // préremplie à émission + 7 jours par l'API, modifiable par le tatoueur
  respondedAt   DateTime?   @map("responded_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  @@map("quote")
}

model Appointment {
  id              Int               @id @default(autoincrement())
  date            DateTime
  durationMinutes Int               @map("duration_minutes") // durée annoncée au devis = durée du créneau réservé
  location        String?           @db.VarChar(255)
  status          AppointmentStatus

  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  @@map("appointment")
}

model Sketch {
  id           Int          @id @default(autoincrement())
  version      Int
  status       SketchStatus
  originalFile String       @map("original_file") @db.VarChar(255)
  preview      String?      @db.VarChar(255)
  validatedAt  DateTime?    @map("validated_at")

  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  comments SketchComment[]

  @@unique([projectId, version])
  @@map("sketch")
}

model Reference {
  id     Int             @id @default(autoincrement())
  file   String          @db.VarChar(255)
  source ReferenceSource

  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  @@map("reference")
}

model RequestComment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  authorId Int     @map("account_id")
  author   Account @relation(fields: [authorId], references: [id])

  @@map("request_comment")
}

model SketchComment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  sketchId Int    @map("sketch_id")
  sketch   Sketch @relation(fields: [sketchId], references: [id])

  authorId Int     @map("account_id")
  author   Account @relation(fields: [authorId], references: [id])

  @@map("sketch_comment")
}

// Tags (remplace l'ancien champ Project.style)
model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(50)

  projects ProjectTag[]

  @@map("tag")
}

model ProjectTag {
  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tagId Int @map("tag_id")
  tag   Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@map("project_tag")
}
