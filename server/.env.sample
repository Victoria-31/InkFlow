# Base de données PostgreSQL
DATABASE_URL="postgresql://inkflow:inkflow@localhost:5432/inkflow?schema=public"

# Authentification JWT
JWT_SECRET="change_me_with_a_long_random_string"
JWT_EXPIRES_IN="7d"

# Serveur
PORT=3000

# Stockage objet (Cloudflare R2 / Supabase Storage) — compatible S3
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Envoi d'e-mails (Nodemailer) — fiche cicatrisation, invitations
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="InkFlow <no-reply@inkflow.app>"

# Generate with: openssl rand -base64 32
APP_SECRET="change_me_with_a_long_random_string"