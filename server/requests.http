# Manual API checks - needs the "REST Client" VS Code extension
# Run `pnpm dev` and `pnpm db:seed` first. Cookies are kept between requests.

@baseUrl = http://localhost:3000/api

### Health
GET {{baseUrl}}/health

### Auth — login (seed account)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "ren@inkflow.dev",
  "password": "inkflow-dev"
}

### Auth — wrong password (401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "ren@inkflow.dev",
  "password": "wrong-password"
}

### Auth — unknown email (401, same response as above)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "nobody@inkflow.dev",
  "password": "inkflow-dev"
}

### Auth — invalid body (400)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "not-an-email",
  "password": ""
}

### Auth — current account (401 if not logged in)
GET {{baseUrl}}/auth/me

### Auth — logout
POST {{baseUrl}}/auth/logout

### Artists — public profile
GET {{baseUrl}}/artists/ren

### Artists — send a project request
# @name projectRequest
POST {{baseUrl}}/artists/ren/projects
Content-Type: application/json

{
  "firstName": "Léa",
  "lastName": "Martin",
  "email": "lea@example.com",
  "bodyArea": "Nuque",
  "size": "8 cm",
  "budgetMin": 300,
  "budgetMax": 450,
  "description": "Un ensō avec quelques tiges de bambou.",
  "availability": ["TUE_PM"],
  "flexibleSchedule": false,
  "consent": true
}

# The requests below need the project request above, then a login (artist first, client further down)
### Artist space — own project (200)
GET {{baseUrl}}/artist/projects/{{projectRequest.response.body.id}}

### Artist space — unknown or another artist's project (404, same response)
GET {{baseUrl}}/artist/projects/2147483647

### Artist space — malformed id (400 invalid_id)
GET {{baseUrl}}/artist/projects/0x10

### Client space — as the artist (403)
GET {{baseUrl}}/client/projects/1

### Client — login (seed account, linked to one of Ren's projects)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "lea@inkflow.dev",
  "password": "inkflow-dev"
}

### Client space — project the client is not linked to (404); the linked one is in Prisma Studio
GET {{baseUrl}}/client/projects/{{projectRequest.response.body.id}}

### Artist space — as the client (403)
GET {{baseUrl}}/artist/projects/{{projectRequest.response.body.id}}
